# Offline Sui Move rules, kept as exact copies (see README.md).
load(":defs.bzl", "move_rules_copy_test")

exports_files(
    [
        "MANIFEST.sha256",
        "defs.bzl",
        "repositories.bzl",
        "runner.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

move_rules_copy_test(
    name = "copy_test",
    size = "small",
    # Every file under this directory, nested ones included, so any added file
    # fails until it is listed (the copy is flat).
    files = glob(
        ["**"],
        exclude = ["MANIFEST.sha256"],
    ),
    manifest = "MANIFEST.sha256",
    tags = ["block-network"],
    # The check uses GNU coreutils' sha256sum --check --strict.
    target_compatible_with = ["@platforms//os:linux"],
)
