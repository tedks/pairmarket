load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = [
        "src/brand.ts",
        "src/capabilities.ts",
        "src/custody.ts",
        "src/ids.ts",
        "src/index.ts",
        "src/network.ts",
        "src/privacy.ts",
        "src/tx.ts",
        "src/validation.ts",
    ],
)

ts_project(
    name = "core_typecheck",
    testonly = True,
    srcs = [
        "src/brand.ts",
        "src/capabilities.ts",
        "src/custody.ts",
        "src/ids.ts",
        "src/index.ts",
        "src/network.ts",
        "src/privacy.ts",
        "src/tx.ts",
        "src/validation.ts",
        "test/core-invariants.types.ts",
        "test/ids.types.ts",
    ],
    no_emit = True,
    tsconfig = "tsconfig.json",
    visibility = ["//:__pkg__"],
)

js_test(
    name = "ids_runtime_test",
    testonly = True,
    data = [
        "test/ids.runtime.mjs",
        ":sources",
        "//:tsx_loader",
    ],
    entry_point = "test/ids.runtime.mjs",
    node_options = ["--import=tsx"],
    visibility = ["//:__pkg__"],
)

js_test(
    name = "plaintext_runtime_test",
    testonly = True,
    data = [
        "test/plaintext.runtime.mjs",
        ":sources",
        "//:tsx_loader",
    ],
    entry_point = "test/plaintext.runtime.mjs",
    node_options = ["--import=tsx"],
    visibility = ["//:__pkg__"],
)
