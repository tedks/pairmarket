load("@aspect_rules_js//npm:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:private"])

exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "tsx_loader",
    srcs = [":node_modules/tsx"],
    visibility = ["//packages/core/test:__pkg__"],
)

test_suite(
    name = "verify_core",
    tests = [
        "//packages/core:core_typecheck_test",
        "//packages/core/test:ids_runtime_test",
        "//packages/core/test:plaintext_runtime_test",
    ],
)
