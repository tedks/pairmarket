module(
    name = "pairmarket",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "aspect_rules_ts", version = "3.5.2")
bazel_dep(name = "aspect_tools_telemetry", version = "0.3.3")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_shell", version = "0.4.1")

# Disable Aspect collectors in the module itself, regardless of shell env.
single_version_override(
    module_name = "aspect_tools_telemetry",
    patch_strip = 1,
    patches = ["//build_defs:telemetry-disabled.patch"],
    version = "0.3.3",
)

telemetry = use_extension("@aspect_tools_telemetry//:extension.bzl", "telemetry")
use_repo(telemetry, "aspect_tools_telemetry_report")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")

# Match nodejs_24 from the locked nixpkgs flake used by the local toolchain.
node.toolchain(node_version = "24.15.0")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
typescript.deps(
    ts_integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
    ts_version = "6.0.3",
)
use_repo(typescript, "npm_typescript")

pairmarket_source = use_repo_rule("//build_defs:pairmarket_source.bzl", "pairmarket_source")

pairmarket_source(name = "pairmarket_src")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "pairmarket_npm",
    lifecycle_hooks = {"*": []},
    pnpm_lock = "@pairmarket_src//:pnpm-lock.yaml",
    use_home_npmrc = False,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "pairmarket_npm")
